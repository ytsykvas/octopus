{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"]
    }
  },
  "include": [
    "src/core/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "scripts/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
