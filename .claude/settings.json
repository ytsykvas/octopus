{
  "permissions": {
    "deny": ["Edit(node_modules/**)", "Write(node_modules/**)", "Edit(.git/**)", "Write(.git/**)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
